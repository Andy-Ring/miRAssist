# Posit Connect Cloud direct mode
MIRASSIST_APP_MODE=direct
MIRASSIST_LLM_BACKEND=openai
OPENAI_API_KEY=sk...
MIRASSIST_PLANNER_MODEL=gpt-5.4-nano
MIRASSIST_SYNTH_MODEL=gpt-5.4-mini
MIRASSIST_SYNTH_MAX_TOKENS=2500
MIRASSIST_OPENAI_BASE_URL=
MIRASSIST_OPENAI_TIMEOUT=600
MIRASSIST_OPENAI_TEMPERATURE_PLANNER=0
MIRASSIST_OPENAI_TEMPERATURE_SYNTH=0.2
MIRASSIST_DEFAULT_RESULT_COUNT=5
JOBSTORE_BACKEND=filesystem
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
EVIDENCE_BACKEND=filesystem
EVIDENCE_TABLE=mirassist_backend_features

# Optional local development fallbacks
MIRASSIST_EVIDENCE=data/processed/mirassist_backend_features.parquet
MIRASSIST_JOB_DIR=runs/jobs
MIRASSIST_DEFAULT_K=10

# Optional API mode
BACKEND_URL=http://127.0.0.1:7861
MIRASSIST_BACKEND_URL=http://127.0.0.1:7861
WORKER_MODE=subprocess
MIRASSIST_DEBUG_UI=0

# Local Transformers mode
# MIRASSIST_LLM_BACKEND=transformers
# MIRASSIST_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# vLLM mode
# MIRASSIST_LLM_BACKEND=vllm_http
# MIRASSIST_VLLM_HTTP_URL=http://127.0.0.1:8000
# MIRASSIST_VLLM_URL=http://127.0.0.1:8000
# MIRASSIST_VLLM_API_KEY=
