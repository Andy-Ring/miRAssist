# miRAssist Streamlit app configuration (Posit Connect Cloud direct mode)
# Evidence now comes from a GitHub-hosted CSV snapshot, so Supabase is optional.

MIRASSIST_APP_MODE=direct

# --- LLM (planner + synthesizer) ---
MIRASSIST_LLM_BACKEND=openai
OPENAI_API_KEY=sk-...
MIRASSIST_PLANNER_MODEL=gpt-5.4-nano
MIRASSIST_SYNTH_MODEL=gpt-5.4-mini
MIRASSIST_SYNTH_MAX_TOKENS=2500
MIRASSIST_OPENAI_TIMEOUT=600
MIRASSIST_OPENAI_TEMPERATURE_PLANNER=0
MIRASSIST_OPENAI_TEMPERATURE_SYNTH=0.2
MIRASSIST_DEFAULT_RESULT_COUNT=5

# --- Evidence source (default: GitHub-hosted snapshot; no database needed) ---
EVIDENCE_BACKEND=github
# Optional: override the snapshot URL (defaults to the pinned release in backend/config.py)
# MIRASSIST_EVIDENCE_URL=https://github.com/Andy-Ring/miRAssist/releases/download/v0.0.1/mirassist_evidence_pairs.csv.gz
# Optional: cache dir for the downloaded snapshot (defaults to ~/.cache/mirassist)
# MIRASSIST_CACHE_DIR=/var/tmp/mirassist

# --- Job storage (filesystem = no database) ---
JOBSTORE_BACKEND=filesystem
MIRASSIST_JOB_DIR=runs/jobs
MIRASSIST_DEFAULT_K=10

# --- Crash isolation and hosted native-library limits ---
# MIRASSIST_DEBUG_STAGE=planner|retrieval|ranking|prompt|synthesis
# MIRASSIST_DEBUG_STAGE is unset in normal operation.
# Native numerical libraries are capped at one thread at process startup.

# --- Optional: local parquet instead of the GitHub snapshot (offline dev) ---
# EVIDENCE_BACKEND=parquet
# MIRASSIST_EVIDENCE=data/processed/mirassist_backend_features.parquet
# MIRASSIST_ALLOW_PARQUET_SNAPSHOT=1

# --- Optional: legacy live Supabase (no longer required) ---
# EVIDENCE_BACKEND=postgres
# EVIDENCE_TABLE=mirassist_evidence_pairs
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# JOBSTORE_BACKEND=postgres
