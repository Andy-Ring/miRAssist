/outputs/
*.out
*.err
*.sbatch.log
*.orig

# Local research and validation pipelines. These reproduce internal candidate-universe,
# planner, and synthesis studies but are not part of the v1.0 application or skill.
/candidate_generation/
/configs/
/docs/evidence_table_consumers.md
/docs/*candidate_universe_decision_report.md
/docs/sequence_*.md
/scripts/*.sbatch
/scripts/*legacy*
/scripts/*model*
/scripts/*planner*
/scripts/*sequence*
/scripts/*synthesis*
/scripts/*tiered*
/scripts/*variant_a*
/scripts/reconstruct_tcga_fdr.py
/scripts/validate_site_orientation.py
/tests/test_llm_validation*
/tests/test_model*
/tests/test_planner*
/tests/test_sequence*
/tests/test_synthesis*
/tests/test_tiered*
/tests/test_variant_a*

