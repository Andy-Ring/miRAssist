.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Local runtime / scratch output
# ---------------------------------------------------------------------------
runs/
logs/
*.log
.cache/
mirassist_cache/
evidence_*.parquet          # downloaded evidence-snapshot cache
evaluation/outputs/*
!evaluation/outputs/.gitkeep

# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------------
# Data — the evidence table and pathway files are shipped so a local clone works
# offline; only the large legacy/intermediate tables are excluded.
# ---------------------------------------------------------------------------
/data/processed/*.parquet
/data/processed/*.csv
!/data/processed/pathways/
!/data/processed/mirassist_evidence_pairs.parquet
/mirassist_evidence_pairs_test.csv

# ---------------------------------------------------------------------------
